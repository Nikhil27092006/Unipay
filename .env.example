# ==============================================================================
# Unipay (CoWallet) - Environment Configuration
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Security & JWT Secrets (Change in production!)
SECRET_KEY=unipay_super_secret_jwt_key_change_me_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Default: SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./unipay.db
# DATABASE_URL=postgresql://user:password@localhost:5432/unipay

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api
